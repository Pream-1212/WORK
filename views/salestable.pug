extends table_layout
block content
  .container.mt-5
    h3.mb-3 Sales Records

    // Date filter form
    .card.p-3.mb-4.shadow-sm
      form(method='get', action='/salesdata').row.g-2.align-items-end
        .col-md-3
          label.form-label(for="startDate") Start Date
          input#startDate.form-control(type='date', name='startDate', value=startDate)
        .col-md-3
          label.form-label(for="endDate") End Date
          input#endDate.form-control(type='date', name='endDate', value=endDate)
        .col-md-2
          button.btn.btn-success(type='submit') Filter
        .col-md-2
          a.btn.btn-secondary(href='/salesdata') Clear

    // Summary cards
    if totalRevenue !== undefined
      .row.g-2.mb-4
        .col-md-3
          .card.p-2.text-center.shadow-sm
            h6 Total Revenue
            h5 UGX #{Number(totalRevenue).toLocaleString()}
        .col-md-3
          .card.p-2.text-center.shadow-sm
            h6 Total Items Sold
            h5 #{totalQuantity}
        .col-md-3
          .card.p-2.text-center.shadow-sm
            h6 Transport Charges
            h5 UGX #{Number(totalTransport).toLocaleString()}
        .col-md-3
          .card.p-2.text-center.shadow-sm
            h6 Total Sales
            h5 #{sales ? sales.length : 0}

    // Bootstrap Icons CDN
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css")

    table.table.table-bordered.table-striped.table-sm(style="font-size: 0.9rem;")
      thead.table-dark
        tr
          th Date
          th Customer Name
          th Product Name
          th Product Type
          th Quantity
          th Unit Price
          th Transport
          th Total
          th Agent
          th Payment
          th Delivery
          if currentUser && currentUser.role === 'manager'
            th.text-center(style="width:60px") Update
            th.text-center(style="width:60px") Delete
      tbody
        if sales && sales.length
          each sale in sales
            tr
              td #{moment(sale.date).format('DD/MM/YYYY')}
              td #{sale.name}
              td #{sale.productName}
              td #{sale.productType}
              td #{sale.quantity}
              td #{sale.unitPrice}
              td #{sale.transportCharge ? sale.transportCharge.toFixed(2) : 0}
              td #{sale.totalPrice ? sale.totalPrice.toFixed(2) : sale.unitPrice * sale.quantity}
              td #{sale.agent ? sale.agent.name : "N/A"}
              td #{sale.payment}
              td #{sale.delivery}
              if currentUser && currentUser.role === 'manager'
                td.text-center
                  a.btn.btn-sm.btn-outline-warning(href=`/editsales/${sale._id}`, title="Edit")
                    i.bi.bi-pencil-square
                td.text-center
                  form(method='post', action=`/deletesales/${sale._id}`)
                    button.btn.btn-sm.btn-outline-danger(type='submit', title="Delete")
                      i.bi.bi-trash
        else
          tr
            td(colspan="12").text-center No sales available

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
