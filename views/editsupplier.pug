extends edit_layout

block content
  main.container
    h3.mt-4 Edit Supplier
    .form-card.card.shadow.mx-auto.mb-5.p-4(style="max-width:500px")
      form(action=`/edit-supplier/${supplier._id}`, method='post')
        .mb-3
          label.form-label(for="name") Supplier Name
          input#name.form-control(type="text", name="name", value=supplier.name, required)
        .mb-3
          label.form-label(for="contactPerson") Contact Person
          input#contactPerson.form-control(type="text", name="contactPerson", value=supplier.contactPerson || '')
        .mb-3
          label.form-label(for="email") Email
          input#email.form-control(type="email", name="email", value=supplier.email || '')
        .mb-3
          label.form-label(for="phone") Phone
          input#phone.form-control(type="tel", name="phone", value=supplier.phone, required)
        .mb-3
          label.form-label(for="address") Address
          input#address.form-control(type="text", name="address", value=supplier.address || '')
        .mb-3
          label.form-label(for="productsSupplied") Products Supplied
          input#productsSupplied.form-control(type="text", name="productsSupplied", value=supplier.productsSupplied || '')
        .mb-3
          label.form-label(for="commission") Commission (%)
          input#commission.form-control(type="number", name="commission", value=supplier.commission || 0, step="0.01", min="0")
        button.btn.btn-success(type="submit") Update Supplier

  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js")
