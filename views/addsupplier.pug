extends edit_layout

block content
  main.container
    h3.mt-4 Add New Supplier
    .form-card.card.shadow.mx-auto.mb-5.p-4(style="max-width:500px")
      form(action='/add-supplier', method='post')
        .mb-3
          label.form-label(for="name") Supplier Name
          input#name.form-control(type="text", name="name", placeholder="Supplier name", required)
        .mb-3
          label.form-label(for="contactPerson") Contact Person
          input#contactPerson.form-control(type="text", name="contactPerson", placeholder="Contact person name")
        .mb-3
          label.form-label(for="email") Email
          input#email.form-control(type="email", name="email", placeholder="Email address")
        .mb-3
          label.form-label(for="phone") Phone
          input#phone.form-control(type="tel", name="phone", placeholder="Phone number", required)
        .mb-3
          label.form-label(for="address") Address
          input#address.form-control(type="text", name="address", placeholder="Physical address")
        .mb-3
          label.form-label(for="productsSupplied") Products Supplied
          input#productsSupplied.form-control(type="text", name="productsSupplied", placeholder="e.g. Timber, Poles, Hardwood")
        .mb-3
          label.form-label(for="commission") Commission (%)
          input#commission.form-control(type="number", name="commission", placeholder="e.g. 5", step="0.01", min="0")
        button.btn.btn-success(type="submit") Add Supplier

  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js")
