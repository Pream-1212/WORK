extends edit_layout

block content
  main.container
    h3.mt-4 Edit Stock Item
    .form-card.card.shadow.mx-auto.mb-5.p-4(style="max-width:500px")
      form(action=`/editstock/${item._id}`, method='post')
        .mb-3
          label.form-label(for="productName") Product Name
          select#productName.form-control(name='productName', required)
            option(value='') -- Select Product --
            option(value='Officefurniture' selected=(item.productName === 'Officefurniture')) Officefurniture
            option(value='Softwood' selected=(item.productName === 'Softwood')) Softwood
            option(value='Hardwood' selected=(item.productName === 'Hardwood')) Hardwood
            option(value='Cupboards' selected=(item.productName === 'Cupboards')) Cupboards
            option(value='Beds' selected=(item.productName === 'Beds')) Beds
            option(value='Cabinets' selected=(item.productName === 'Cabinets')) Cabinets
            option(value='Poles' selected=(item.productName === 'Poles')) Poles
            option(value='Woodchips' selected=(item.productName === 'Woodchips')) Woodchips
            option(value='Diningtables' selected=(item.productName === 'Diningtables')) Diningtables
            option(value='Wardrobes' selected=(item.productName === 'Wardrobes')) Wardrobes
        .mb-3
          label.form-label(for="productType") Product Type
          select#productType.form-control(name='productType', required)
            option(value='Wood' selected=(item.productType === 'Wood')) Wood
            option(value='Furniture' selected=(item.productType === 'Furniture')) Furniture
        .mb-3
          label.form-label(for="costPrice") Cost Price
          input#costPrice.form-control(type='number', name='costPrice', value=item.costPrice, required)
        .mb-3
          label.form-label(for="sellPrice") Selling Price
          input#sellPrice.form-control(type='number', name='sellPrice', value=item.sellPrice, required)
        .mb-3
          label.form-label(for="quantity") Quantity
          input#quantity.form-control(type='number', name='quantity', value=item.quantity, required)
        .mb-3
          label.form-label(for="supplierName") Supplier Name
          input#supplierName.form-control(type='text', name='supplierName', value=item.supplierName || '')
        .mb-3
          label.form-label(for="quality") Quality
          select#quality.form-control(name='quality', required)
            option(value='Low' selected=(item.quality === 'Low')) Low
            option(value='High' selected=(item.quality === 'High')) High
        .mb-3
          label.form-label(for="color") Color (optional)
          input#color.form-control(type='text', name='color', value=item.color || '')
        .mb-3
          label.form-label(for="measurements") Measurements (optional)
          input#measurements.form-control(type='text', name='measurements', value=item.measurements || '')
        button.btn.btn-success(type="submit") Update Stock

  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js")
